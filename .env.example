# Copy to .env for LOCAL development only. Never commit .env.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://aegis:aegis_dev_pw@localhost:5432/aegis
DATABASE_SSL=false
# AUTH_MODE=dev is refused when NODE_ENV=production. Use entra for any shared deployment.
AUTH_MODE=dev
# ENTRA_TENANT_ID=<your tenant id>
# ENTRA_API_AUDIENCE=api://<api app registration client id>
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
APPROVAL_TTL_HOURS=24
MEDIUM_REQUIRES_APPROVAL_IN=prod
MIN_CONFIDENCE_FOR_AUTO_ALLOW=0.8
AGENT_TIMEOUT_MS=30000
# Resource Graph needs real Azure credentials (az login locally, managed identity in Azure).
ARG_ENABLED=false
LLM_PROVIDER=none
# AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment name>
# AZURE_OPENAI_API_KEY=<from Key Vault, never commit>
