# Copy to config.env and edit. config.env is git-ignored.
ADMIN_EMAIL="you@example.com"        # budget alerts go here
ENV_NAME="dev"                       # environment name used in resource names (aegis-dev-...)
RG_NAME="rg-aegis"                   # resource group for AEGIS itself
DEMO_RG_DEV="rg-demo-dev"            # demo workload resource groups (the "other application")
DEMO_RG_PROD="rg-demo-prod"
BUDGET_USD=150                       # budget ALERT only; it does not stop spending
# Regions tried in order. A region is chosen only if Container Apps AND PostgreSQL B1ms really work there.
REGIONS="southeastasia centralindia eastasia westeurope northeurope eastus2 uksouth"
# LOCATION="southeastasia"           # uncomment to force a region (also set FORCE_REGION=1)
# FORCE_REGION=1
# DEMO_LOCATION=""                   # defaults to LOCATION
# ADMIN_OID=""                       # only needed if you log in with a service principal
# ENTRA_PROVIDED=1                   # set when an admin created the app registrations for you
# API_APPID=""                       # then fill these two (see ADMIN-REQUEST.md)
# WEB_APPID=""
