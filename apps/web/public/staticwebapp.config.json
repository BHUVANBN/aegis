{
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/assets/*", "/*.ico", "/*.svg", "/*.json"] },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
